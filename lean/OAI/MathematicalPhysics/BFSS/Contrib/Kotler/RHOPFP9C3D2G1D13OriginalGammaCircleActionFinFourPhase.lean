import OAI.MathematicalPhysics.BFSS.Contrib.Kotler.RHOPFP9C3D2G1D12OriginalGammaCirclePhaseProjectorRange
import OAI.MathematicalPhysics.BFSS.Contrib.Kotler.RHOPFP9C3D2BOriginalGammaCircleProjectorImageInvariance

/-!
# RHOPF-P9C3D2G1D13 — original Gamma9 Circle action transported to real-four

Define the exact original source Gamma9 circle matrix-vector action
restricted to the source rank-four projector range; then conjugate it
through the accepted (noncanonical) real-linear equivalence E to Fin 4 → ℝ.
Prove that this genuine transported source action satisfies
  rho_4(z) x = re(z) • x + im(z) • J_4 x,
where J_4 is the previously qualified exact Gamma9 phase linear conjugate.

No substituted complex multiplication, orthonormal basis, canonical Hopf
quotient, Fock lift or physical claims.
-/

set_option autoImplicit false

namespace FCP.RHOPFP9C3D2G1D13
noncomputable section

open OAI.BFSSQuantum
open FCP.RHOPFP9C1A
open FCP.RHOPFP9C1B1
open FCP.RHOPFP9C3D2A
open FCP.RHOPFP9C3D2B
open FCP.RHOPFP9C3D2G1C0
open FCP.RHOPFP9C3D2G1D9
open FCP.RHOPFP9C3D2G1D10
open FCP.RHOPFP9C3D2G1D12

/-- Original Gamma9 source matrix Circle action restricted to its
actual source-defined rank-four projector range. -/
noncomputable def relationalCircleRangeAction
    (z : Circle)
    (v : LinearMap.range (Matrix.toLin' relationalProjector)) :
    LinearMap.range (Matrix.toLin' relationalProjector) := by
  have hProj : LinearMap.IsProj
      (LinearMap.range (Matrix.toLin' relationalProjector))
      (Matrix.toLin' relationalProjector) :=
    (LinearMap.isProj_range_iff_isIdempotentElem
      (Matrix.toLin' relationalProjector)).2
        relationalProjector_toLin_idempotent
  have hv : relationalProjector.mulVec v.1 = v.1 :=
    hProj.map_id v.1 v.2
  exact ⟨relationalCircleVector z v.1,
    ⟨relationalCircleVector z v.1,
      relationalCircleVector_preserves_projector_image z v.1 hv⟩⟩

/-- Noncanonical real-four coordinate action transported from the
literal original Gamma9 circle matrix action via E and E⁻¹. -/
noncomputable def relationalCircleFourAction
    (z : Circle) (x : Fin 4 → ℝ) : Fin 4 → ℝ :=
  relationalRangeContinuousLinearEquivFinFour
    (relationalCircleRangeAction z
      (relationalRangeContinuousLinearEquivFinFour.symm x))

/-- Exact native circle action on original projector range is
generated by the original source J_range, not a guessed complex basis. -/
theorem relationalCircleRangeAction_phase
    (z : Circle)
    (v : LinearMap.range (Matrix.toLin' relationalProjector)) :
    relationalCircleRangeAction z v =
      (z : ℂ).re • v + (z : ℂ).im • relationalPhaseJRangeLinear v := by
  apply Subtype.ext
  change relationalCircleVector z v.1 =
      (z : ℂ).re • v.1 +
        (z : ℂ).im • (relationalPhaseJRangeLinear v).1
  exact relationalCircleVector_phase_on_projector_range z v

/-- Transported original Gamma9 Circle action has the real-four
complex-structure phase formula, with the accepted J₄. -/
theorem relationalCircleFourAction_phase
    (z : Circle) (x : Fin 4 → ℝ) :
    relationalCircleFourAction z x =
      (z : ℂ).re • x +
        (z : ℂ).im • relationalPhaseJFourLinear x := by
  let E := relationalRangeContinuousLinearEquivFinFour
  calc
    relationalCircleFourAction z x =
        E (relationalCircleRangeAction z (E.symm x)) := by
          rfl
    _ = E ((z : ℂ).re • (E.symm x) +
        (z : ℂ).im • relationalPhaseJRangeLinear (E.symm x)) := by
          rw [relationalCircleRangeAction_phase]
    _ = (z : ℂ).re • x +
        (z : ℂ).im • relationalPhaseJFourLinear x := by
          rw [map_add, map_smul, map_smul, E.apply_symm_apply]
          rfl

