import OAI.MathematicalPhysics.BFSS.Contrib.Kotler.SU2BFSSPhysicalDomainS1V52K1D18V7BOriginalSourceEuclideanNormAndCartanBoundaryProbe
import OAI.MathematicalPhysics.BFSS.Contrib.Kotler.SU2BFSSPhysicalDomainS1V52K1D16OriginalSpin48QuadraticIsometryProbe

/-!
K1D18V7C — transport the actual original source-Q isometries,
via the exact 48-label L2 norm equality accepted in V7B, to
the corresponding Euclidean LinearIsometryEquiv.

NO substitute quadratic form: source Q and source vector action
remain unchanged. The auxiliary Euclidean space carries precisely
the original 48 indices, and the underlying equiv is the explicitly
typed canonical WithLp.linearEquiv, not an inferred relabeling.

This is an isometry-TRANSPORT bridge only; the Cartan reflection
word and its original Clifford line-axis image remain unproved,
as do SO-image surjectivity, covering, global Spin9 and spectra.
CANDIDATE pending strict independent pinned CI.
-/

set_option autoImplicit false

namespace FCP.BFSSS1V52K1D18V7C
noncomputable section
open FCP.BFSSS1V0

private abbrev Q : QuadraticForm ℝ Source48Vector := source48Quadratic
private abbrev Euc48 := EuclideanSpace ℝ Source48Label

/-- Typed canonical linear equivalence from the ORIGINAL 48-coordinate
real function space to the Euclidean L2 space on the SAME labels. -/
noncomputable def originalSource48ToEuclidean : Source48Vector ≃ₗ[ℝ] Euc48 :=
  (WithLp.linearEquiv 2 ℝ Source48Vector).symm

/-- This transported vector is literally the same coordinate array
with the Euclidean L2 norm, not a permutation or a new source Q. -/
theorem originalSource48ToEuclidean_apply (a : Source48Vector) :
    originalSource48ToEuclidean a = WithLp.toLp 2 a := by
  rfl

/-- The accepted V7B original-Q/L2 norm theorem expressed using
the exact source-indexed linear equivalence. -/
theorem originalSource48ToEuclidean_norm_sq_eq_Q (a : Source48Vector) :
    ‖originalSource48ToEuclidean a‖ ^ 2 = Q a := by
  rw [originalSource48ToEuclidean_apply]
  exact (FCP.BFSSS1V52K1D18V7B.source48Quadratic_eq_euclidean_norm_sq a).symm

/-- Conjugation of an arbitrary accepted original quadratic-form
isometry by the exact coordinate-to-L2 linear equivalence. -/
noncomputable def originalSourceQIsometry_toEuclideanLinearEquiv
    (i : Q.IsometryEquiv Q) : Euc48 ≃ₗ[ℝ] Euc48 :=
  originalSource48ToEuclidean.symm.trans
    ((i : Source48Vector ≃ₗ[ℝ] Source48Vector).trans originalSource48ToEuclidean)

/-- Genuine Euclidean L2 norm preservation, derived entirely from
the actual original Q-preserving map and V7B's equality. -/
theorem originalSourceQIsometry_toEuclidean_norm_map
    (i : Q.IsometryEquiv Q) (v : Euc48) :
    ‖originalSourceQIsometry_toEuclideanLinearEquiv i v‖ = ‖v‖ := by
  let x : Source48Vector := originalSource48ToEuclidean.symm v
  have htransport :
      originalSourceQIsometry_toEuclideanLinearEquiv i v =
        originalSource48ToEuclidean (i x) := by
    rfl
  have hx : originalSource48ToEuclidean x = v :=
    originalSource48ToEuclidean.apply_symm_apply v
  have hQ : Q (i x) = Q x := i.map_app' x
  have hnormsq :
      ‖originalSource48ToEuclidean (i x)‖ ^ 2 =
        ‖originalSource48ToEuclidean x‖ ^ 2 := by
    calc
      ‖originalSource48ToEuclidean (i x)‖ ^ 2 = Q (i x) :=
        originalSource48ToEuclidean_norm_sq_eq_Q (i x)
      _ = Q x := hQ
      _ = ‖originalSource48ToEuclidean x‖ ^ 2 :=
        (originalSource48ToEuclidean_norm_sq_eq_Q x).symm
  rw [htransport, ← hx]
  nlinarith [norm_nonneg (originalSource48ToEuclidean (i x)),
    norm_nonneg (originalSource48ToEuclidean x)]

/-- Actual source-Q isometry transported to a TRUE Mathlib
Euclidean LinearIsometryEquiv. This is only a typed bridge,
NOT a proof that the original source SO is generated by pairs. -/
noncomputable def originalSourceQIsometry_toEuclideanIsometry
    (i : Q.IsometryEquiv Q) : Euc48 ≃ₗᵢ[ℝ] Euc48 :=
  { originalSourceQIsometry_toEuclideanLinearEquiv i with
    norm_map' := originalSourceQIsometry_toEuclidean_norm_map i }

#print axioms originalSource48ToEuclidean
#print axioms originalSource48ToEuclidean_apply
#print axioms originalSource48ToEuclidean_norm_sq_eq_Q
#print axioms originalSourceQIsometry_toEuclideanLinearEquiv
#print axioms originalSourceQIsometry_toEuclidean_norm_map
#print axioms originalSourceQIsometry_toEuclideanIsometry

end
end FCP.BFSSS1V52K1D18V7C
